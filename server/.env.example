# Nguồn API MangaDex - không sửa ở production
MANGADEX_BASE_URL=https://api.mangadex.org

# BẮT BUỘC theo chính sách MangaDex: User-Agent phải có tên app + đường dẫn liên hệ
# đổi tên và URL của bạn trước khi phát hành
MANGADEX_USER_AGENT=DocHong/1.0 (+https://example.com/lien-he)

# Cổng của máy chủ proxy
PORT=4000

# Cho phép frontend gọi chéo origin (chỉ cần khi chạy dev tách riêng)
CORS_ORIGIN=http://localhost:3000

# Ép MangaDex@Home chạy cổng HTTPS 443
FORCE_PORT_443=false

# Mức nội dung tối đa cho phép: safe | suggestive | erotica | pornographic
CONTENT_RATING_MAX=suggestive