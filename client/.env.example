# Không bắt buộc. Để trống thì website tự chạy được trên bất kỳ tên miền nào.

# Chỉ đặt khi máy chủ proxy nằm ở một máy khác (ví dụ khi deploy).
# Nếu proxy chạy cùng máy hoặc dưới cùng tên miền, có thể để trống.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Chỉ đặt khi cần một tên miền cố định cho metadata và sitemap.
# Bỏ trống thì hệ thống tự lấy domain từ request hiện tại.
NEXT_PUBLIC_SITE_URL=